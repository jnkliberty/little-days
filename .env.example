# install.py writes the real .env for you. This file shows every setting. Git ignores .env.
LITTLE_DAYS_ORIGIN=https://localhost
LITTLE_DAYS_HOST=localhost
LITTLE_DAYS_HTTPS_PORT=443
# 127.0.0.1 lets only this computer open the app. Use 0.0.0.0 to let other devices on your network open it.
LITTLE_DAYS_BIND=127.0.0.1
TZ=America/Chicago
LITTLE_DAYS_UID=1000
LITTLE_DAYS_GID=1000
# AI is off by default. To turn it on, set all three. The key stays in this file and nowhere else.
# LITTLE_DAYS_AI_ENABLED=true
# LITTLE_DAYS_AI_MODEL=claude-haiku-5-5
# LITTLE_DAYS_ANTHROPIC_API_KEY=
