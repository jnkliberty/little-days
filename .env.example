# install.py writes the real .env for you. This file shows every setting. Git ignores .env.
LITTLE_DAYS_ORIGIN=https://localhost
LITTLE_DAYS_HOST=localhost
LITTLE_DAYS_HTTPS_PORT=443
# 127.0.0.1 lets only this computer open the app. Use 0.0.0.0 to let other devices on your network open it.
LITTLE_DAYS_BIND=127.0.0.1
TZ=America/Chicago
LITTLE_DAYS_UID=1000
LITTLE_DAYS_GID=1000
# Ask AI turns on when you add your own key; it uses your credits. With no key it stays off and calls no provider,
# except an OpenAI-compatible server on this computer (localhost), which needs no key. The key stays in this file.
# LITTLE_DAYS_AI_ENABLED=false keeps AI off even with a key.
# Anthropic (default provider; model defaults to claude-haiku-5-5; daily development cards need it):
# LITTLE_DAYS_AI_API_KEY=
# Any OpenAI-compatible API (OpenAI, OpenRouter, Gemini, Ollama, LM Studio); Chat works, daily cards stay off.
# The model must support structured outputs (json_schema).
# LITTLE_DAYS_AI_PROVIDER=openai
# LITTLE_DAYS_AI_BASE_URL=https://openrouter.ai/api/v1
# LITTLE_DAYS_AI_MODEL=openai/gpt-4o-mini
# LITTLE_DAYS_AI_API_KEY=
# Ollama on this computer: LITTLE_DAYS_AI_BASE_URL=http://localhost:11434/v1, a model name, and no key.
# Optional locked-phone web push alerts: set a mailto: or public https: contact address for VAPID.
# LITTLE_DAYS_PUSH_CONTACT=https://your-site.example/contact
